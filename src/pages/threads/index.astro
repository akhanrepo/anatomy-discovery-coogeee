---
import Layout from '../../layouts/Layout.astro';
import { corpus } from '../../lib/content/load';
const c = corpus();
---
<Layout title="Tours" description="Guided tours through the history of the body.">
  <article class="prose">
    <h1>Tours</h1>
    <ul>{c.threads.map((t) => <li><a href={`/threads/${t.id}/`}>{t.title}</a> <span class="small">· {t.discoveries.length} plates</span><br /><span class="small">{t.summary}</span></li>)}</ul>
  </article>
</Layout>
