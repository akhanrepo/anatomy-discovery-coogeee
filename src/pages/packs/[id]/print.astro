---
import { corpus } from '../../../lib/content/load';
import { PACKS, buildPack } from '../../../lib/packs';
import { plateSvg } from '../../../lib/plate';
import { site } from '../../../config/site';
export function getStaticPaths() { return PACKS.map((p) => ({ params: { id: p.id } })); }
const c = corpus();
const p = buildPack(c, Astro.params.id!);
const src = new Map(c.sources.map((s) => [s.id, s]));
// black-line plates: the pack's first discovery shown at each key year (structures inked to that year)
const plates = p.plateYears.map((y) => { const d = p.discoveries.find((x) => x.yearStart === y)!; return { y, label: d.displayDate, svg: plateSvg(d.id, { width: 300, mono: true }) }; });
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><title>{p.def.title} · {site.name} classroom pack</title>
<style>
  @page { margin: 16mm; }
  body { font-family: Georgia, 'Times New Roman', serif; color: black; background: white; font-size: 11.5pt; line-height: 1.45; }
  h1 { font-size: 30pt; margin: 0 0 6pt; } h2 { font-size: 16pt; border-bottom: 1px solid black; margin-top: 18pt; } h3 { font-size: 12.5pt; margin: 10pt 0 4pt; }
  .cover { page-break-after: always; text-align: center; padding-top: 50mm; } .cover .meta { font-size: 10pt; }
  .plates { display: grid; grid-template-columns: 1fr 1fr; gap: 8mm; page-break-after: always; } .plates figure { margin: 0; text-align: center; } .plates svg { width: 100%; height: auto; }
  .card { border: 1px solid black; padding: 8pt; margin: 6pt 0; page-break-inside: avoid; } .ref { font-family: monospace; font-size: 8.5pt; }
  .key li { margin-bottom: 4pt; } .small { font-size: 9pt; }
</style></head>
<body>
  <section class="cover">
    <p class="meta">{site.name.toUpperCase()} · CLASSROOM PACK</p>
    <h1>{p.def.title}</h1>
    <p>{p.def.subtitle}</p>
    <p class="meta" data-testid="pack-version">Edition {p.version} · generated from Tabula content · {p.discoveries.length} plates</p>
    <p class="meta">Fits: {p.def.syllabus}</p>
    <p class="small" data-testid="pack-licence">Licence: {site.licences.content.name} ({site.licences.content.url}). Copy, share and adapt freely, with credit to {site.name} ({site.repo}), and share adaptations on the same terms.</p>
  </section>
  <section class="plates">
    {plates.map((pl) => <figure><Fragment set:html={pl.svg} /><figcaption>The body as known in {pl.label}. Colour what was <em>understood</em>; outline what was only <em>described</em>.</figcaption></figure>)}
  </section>
  <h2>Story cards</h2>
  {p.discoveries.map((d) => <div class="card"><h3>Tab. {d.plate}: {d.title} ({d.displayDate})</h3><p>{d.hook}</p><p><strong>How they knew:</strong> {d.method}</p><p><strong>What it overturned:</strong> {d.overturned}</p><p class="small">Status: {d.status}{d.contestNote ? `. ${d.contestNote}` : ''}</p></div>)}
  <h2>Spot the myth</h2>
  <p>For each statement, decide: was it <em>believed then, later overturned</em>, or is it <em>supported by the sources</em>?</p>
  <ol>{p.myths.map((m) => <li>{m.statement}</li>)}</ol>
  <h2>Discussion questions</h2>
  <ol>{p.questions.map((q) => <li>{q}</li>)}</ol>
  <h2>Answer key and sources</h2>
  <ol class="key">{p.myths.map((m) => <li>{m.answer} <span class="ref" data-claim-ref={m.ref}>[{m.ref}]</span></li>)}</ol>
  <h3>Every claim in this pack</h3>
  <ul class="key">{p.claims.map((k) => <li><span class="ref" data-claim-ref={k.ref}>[{k.ref}]</span> {k.text} <span class="small">({k.status}). Sources: {k.citations.map((r) => { const s = src.get(r.split(':')[0])!; return `${s.author}, ${s.title} (${s.year})`; }).join('; ')}</span></li>)}</ul>
</body></html>
