---
/* F15: follow "This week in anatomy" by RSS. No email, no accounts, nothing sent off-site. */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class={`subscribe ${compact ? 'compact' : ''}`} data-subscribe>
  <p class="smallcaps">This week in anatomy</p>
  <p class="small">One plate a week. Follow by <a href="/feed.xml" data-subscribe-rss>RSS</a>.</p>
</div>
<script>
  document.querySelectorAll('[data-subscribe-rss]').forEach((a) => a.addEventListener('click', () => window.tabulaTrack?.('subscribe', { channel: 'rss' })));
</script>
