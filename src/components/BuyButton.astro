---
/* Commerce (F12/F14). Hosted checkout via the merchant of record; no accounts. Don't change without asking (CLAUDE.md). */
import { site } from '../config/site';
interface Props { product: string; label?: string; school?: boolean }
const { product, label = 'Buy', school = false } = Astro.props;
const p = site.commerce.products[product];
const price = school ? p.schoolPrice : p.price;
const url = p.checkoutUrl ? `${p.checkoutUrl}${school ? (p.checkoutUrl.includes('?') ? '&' : '?') + 'variant=school' : ''}` : '';
---
{url
  ? <a class="btn buy" href={url} rel="noopener" data-checkout={product} data-product={product}>{label} · A${price}{school ? ' (school licence)' : ''}</a>
  : <span class="btn buy is-soon" aria-disabled="true" data-checkout-soon={product}>{label} · A${price}{school ? ' (school licence)' : ''} · coming soon</span>}
<script>
  document.querySelectorAll<HTMLElement>('[data-checkout]').forEach((a) => a.addEventListener('click', () => (window as any).tabulaTrack?.('checkout_start', { product: a.dataset.product })));
</script>
