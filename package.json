{
  "name": "tabula",
  "version": "1.0.0",
  "description": "An engraved human body where every part carries the story of who worked it out, how, and what they got wrong first.",
  "license": "MIT",
  "homepage": "https://tabula-anatomy.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhanrepo/tabula.git"
  },
  "bugs": {
    "url": "https://github.com/akhanrepo/tabula/issues"
  },
  "author": "Ali Khan",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "tsx scripts/validate-content.ts",
    "build": "npm run validate && astro build",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=smoke --project=functional",
    "test:perf": "playwright test --project=perf",
    "test:all": "npm test && npm run build && npm run test:e2e && npm run test:perf",
    "lint": "astro check && tsx scripts/lint-tokens.ts",
    "artefacts": "tsx scripts/build-artefacts.ts"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.4",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.0",
    "satori": "^0.47.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
